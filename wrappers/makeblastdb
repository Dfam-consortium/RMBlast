#!/bin/bash
# Replacement for NCBI makeblastdb used with the Rust rmblastn port.
#
# The Rust rmblastn binary reads the FASTA (or a UCSC 2bit) as its database,
# not a BLAST database.  This wrapper:
#   1. Converts the input FASTA to a .2bit file via faToTwoBit.
#   2. Places the source FASTA at the database base path when '-out' names
#      something other than '-in' -- ../wrappers/rmblastn hands the Rust
#      engine '-db <base>' and reads that FASTA directly, because 2bit
#      degrades IUB ambiguity codes to N.
#   3. Creates dummy BLAST database index files (.ndb, .nhr, .nin, .nog, .nos,
#      .not, .nsq, .ntf, .nto) containing only the word "dummy", so that any
#      caller checking for the existence of a BLAST database will find non-zero
#      files and proceed normally.
#
# The real NCBI makeblastdb is NOT called.
#
# Step 2 matters whenever '-out' differs from '-in'.  RepeatMasker builds its
# databases in place ('-in x.fa -out x.fa'), so the FASTA is already where the
# rmblastn wrapper looks.  But RepeatModeler's
# RepeatUtil::ncbiMaskDatabaseNativeMT builds
#   makeblastdb -out <round-N>/tmpConsDB-1 -in <root>/consensi.fa
# and then searches '-db <round-N>/tmpConsDB-1'.  Nothing ever wrote a FASTA at
# that path, so the rmblastn wrapper aborted with
#   "[rmblastn] Error: database file not found: .../tmpConsDB-1".
# Copying (not symlinking) is deliberate: consensi.fa keeps growing between
# rounds, and the database must stay paired with the sequences it was built
# from.

FATOTWOBIT=/usr/local/ucscTools/faToTwoBit

# Nucleotide BLAST DB extensions created by the real makeblastdb.
NUCL_EXTENSIONS=(ndb nhr nin nog nos not nsq ntf nto)

in_file=""
out_name=""
dbtype="nucl"

args=("$@")
i=0
while [ $i -lt ${#args[@]} ]; do
    case "${args[$i]}" in
        -in)      i=$((i+1)); in_file="${args[$i]}" ;;
        -in=*)               in_file="${args[$i]#*=}" ;;
        -out)     i=$((i+1)); out_name="${args[$i]}" ;;
        -out=*)              out_name="${args[$i]#*=}" ;;
        -dbtype)  i=$((i+1)); dbtype="${args[$i]}" ;;
        -dbtype=*)           dbtype="${args[$i]#*=}" ;;
    esac
    i=$((i+1))
done

if [ -z "$in_file" ]; then
    echo "[makeblastdb] Error: -in <file> is required" >&2
    exit 1
fi

if [ ! -f "$in_file" ]; then
    echo "[makeblastdb] Error: input file not found: $in_file" >&2
    exit 1
fi

base="${out_name:-$in_file}"

# Step 1: build the 2bit file used by the Rust rmblastn binary.
if [ "$dbtype" = "nucl" ]; then
    echo "[makeblastdb] Creating ${base}.2bit" >&2
    "$FATOTWOBIT" "$in_file" "${base}.2bit"
    if [ $? -ne 0 ]; then
        echo "[makeblastdb] Error: faToTwoBit failed" >&2
        exit 1
    fi
fi

# Step 2: put the source FASTA at the database base path when it is not
# already there.  '-ef' compares device+inode, so './x.fa' vs 'x.fa' (and
# symlinks to the same file) count as identical and are left alone.
if [ ! "$in_file" -ef "$base" ]; then
    if cp -f -- "$in_file" "$base"; then
        echo "[makeblastdb] Copied $in_file -> $base (FASTA for the Rust engine)" >&2
    else
        echo "[makeblastdb] Error: failed to copy $in_file -> $base" >&2
        exit 1
    fi
fi

# Step 3: create dummy BLAST index files so callers see a complete-looking database.
for ext in "${NUCL_EXTENSIONS[@]}"; do
    echo "dummy" > "${base}.${ext}"
done

echo "[makeblastdb] Done: ${base}.2bit and dummy index files created" >&2
