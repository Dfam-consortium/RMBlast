#!/bin/bash
# Replacement for NCBI rmblastn used with the Rust rmblastn port.
#
# Legacy callers invoke rmblastn with NCBI BLAST-style arguments:
#   - single-dash flags  (-flag)
#   - underscores in flag names  (-mask_level, -xdrop_ungap, ...)
#   - -dust no  (boolean expressed as no/yes)
#   - -num_alignments  (not implemented in the Rust port)
#
# This wrapper translates all of the above before exec-ing the real binary:
#   1. Single-dash flags are promoted to double-dash  (-foo → --foo).
#   2. Underscores in flag names are replaced with hyphens  (foo_bar → foo-bar).
#   3. -dust no/yes is converted to --dust false/true.
#   4. -num_alignments (and its value) is silently dropped.
#
# (1) and (2) are now also done by the binary itself, so they are belt-and-
# braces; (3) and (4) and the -db handling below are still the wrapper's job.
#   5. The -db value is passed as the FASTA path (any trailing ".2bit" is
#      stripped).  The Rust binary reads FASTA directly; the 2bit format
#      degrades IUB ambiguity codes to N, and all result-equivalence
#      validation was performed against FASTA databases (matches the
#      verify_wrappers behaviour).

# ── Locate the Rust binaries relative to this wrapper ─────────────────────────
# The same script has to work from two layouts:
#   installed release   <root>/wrappers/<this>   -> <root>/bin/<name>
#   source checkout     rmblast/wrappers/<this>  -> rmblast/target/release/<name>
# Both are one level up from the wrapper, so try ../bin first and
# ../target/release second.  Setting RMBLAST_BIN_DIR overrides the search: the
# binary must then be in that directory or the wrapper fails.
#
# Symlinks are followed so the wrappers can be linked onto PATH individually.
__rmb_self="${BASH_SOURCE[0]}"
while [ -L "$__rmb_self" ]; do
    __rmb_dir="$(cd -- "$(dirname -- "$__rmb_self")" && pwd)"
    __rmb_self="$(readlink -- "$__rmb_self")"
    case "$__rmb_self" in /*) ;; *) __rmb_self="$__rmb_dir/$__rmb_self" ;; esac
done
RMBLAST_HERE="$(cd -- "$(dirname -- "$__rmb_self")" && pwd)"

rmblast_find_bin() {
    local name="$1" cand
    # An explicit RMBLAST_BIN_DIR is authoritative: if the binary is not there,
    # fail loudly rather than silently searching elsewhere.
    if [ -n "$RMBLAST_BIN_DIR" ]; then
        if [ -x "$RMBLAST_BIN_DIR/$name" ]; then
            printf '%s\n' "$RMBLAST_BIN_DIR/$name"
            return 0
        fi
        echo "[$(basename -- "$0")] Error: RMBLAST_BIN_DIR is set to '$RMBLAST_BIN_DIR'" \
             "but it holds no executable '$name'." >&2
        return 1
    fi
    for cand in "$RMBLAST_HERE/../bin/$name" \
                "$RMBLAST_HERE/../target/release/$name"; do
        [ -x "$cand" ] && { printf '%s\n' "$cand"; return 0; }
    done
    {
        echo "[$(basename -- "$0")] Error: cannot find the rmblast '$name' binary."
        echo "  looked in: $RMBLAST_HERE/../bin/"
        echo "             $RMBLAST_HERE/../target/release/"
        echo "  Build it with 'cargo build --release' / 'make', or set"
        echo "  RMBLAST_BIN_DIR=<directory containing $name>."
    } >&2
    return 1
}
# ──────────────────────────────────────────────────────────────────────────────

REAL_RMBLASTN="$(rmblast_find_bin rmblastn)" || exit 1

# ── NCBI-shaped "-version" output ─────────────────────────────────────────────
# The Rust binary prints clap's plain "rmblastn 3.0.3".  NCBI prints:
#   rmblastn: 2.17.1+
#    Package: blast 2.17.0, build Apr 28 2026 12:15:13
# The colon and the trailing '+' are not decoration -- every RepeatMasker /
# RepeatModeler version probe depends on that exact shape:
#   NCBIBlastSearchEngine::setPathToEngine
#       /rmblast[n]\s*:?\s*(\S.*)/  then  /(\d+)\.(\d+)\.(\d+)\+/
#       Without the '+' the second match fails, so hasTabFormat /
#       hasQueryThreading / hasDBSoftMasking are never set -- the caller then
#       omits '-outfmt "6 score perc_sub ..."' entirely and silently falls back
#       to the legacy pairwise parser, losing the precomputed kdiv / cpg_kdiv /
#       transi / transv / cross_match stat fields.
#   RepModelConfig.pm         /rmblastn:\s+(\d+\.\d+\.\d+\+?)/
#   RepeatModeler/configure   /rmblastn:\s+(\d+)\.(\d+)\.(\d+)/
#       Both of these need the COLON, which clap does not print either.
#
# Reshaping here rather than in the binary is deliberate: the '+' is an NCBI
# packaging convention, not this project's version, so the Rust binary goes on
# reporting its own honest "rmblastn <ver>".  The version number itself is
# always taken from the binary -- it is never hardcoded in the wrapper.
rmblast_print_version() {
    local raw ver
    raw="$("$REAL_RMBLASTN" --version 2>&1)"
    ver="$(printf '%s\n' "$raw" \
           | sed -n '1s/^[[:space:]]*rmblastn[: ][[:space:]]*\([0-9][^[:space:]]*\).*/\1/p')"
    if [ -z "$ver" ]; then
        printf '%s\n' "$raw"     # unrecognized -- pass the binary through untouched
        return
    fi
    ver="${ver%+}"               # never double up the '+'
    printf 'rmblastn: %s+\n' "$ver"
    printf ' Package: rmblast %s, Rust port\n' "$ver"
}

# Informational invocations short-circuit before any argument translation.
# ('-h' in particular would otherwise be rewritten to the unknown '--h'.)
for a in "$@"; do
    case "$a" in
        -version|--version|-v)
            rmblast_print_version; exit 0 ;;
        -h|-help|--help)
            exec "$REAL_RMBLASTN" --help ;;
    esac
done

args=("$@")
new_args=()
i=0

while [ $i -lt ${#args[@]} ]; do
    arg="${args[$i]}"

    if [[ "$arg" =~ ^(-{1,2})([^=]+)(=.*)?$ ]]; then
        flag_name="${BASH_REMATCH[2]}"
        inline_value="${BASH_REMATCH[3]}"   # non-empty only for --flag=value style

        # normalize underscores → hyphens
        flag_name="${flag_name//_/-}"

        # drop -num-alignments (and its value)
        if [[ "$flag_name" == "num-alignments" ]]; then
            if [[ -n "$inline_value" ]]; then
                i=$((i+1))
            else
                next_i=$((i+1))
                if [ $next_i -lt ${#args[@]} ] && [[ ! "${args[$next_i]}" =~ ^- ]]; then
                    i=$((i+1))
                fi
                i=$((i+1))
            fi
            continue
        fi

        new_flag="--${flag_name}"

        if [[ -n "$inline_value" ]]; then
            # --flag=value style: keep as-is (value already attached)
            new_args+=("${new_flag}${inline_value}")
            i=$((i+1))
        else
            # separate-value style: peek at next token
            next_i=$((i+1))
            if [ $next_i -lt ${#args[@]} ] && [[ ! "${args[$next_i]}" =~ ^- ]]; then
                value="${args[$next_i]}"
                # translate -dust no/yes to --dust false/true
                if [[ "$flag_name" == "dust" ]]; then
                    case "$value" in
                        no|false|0)  value="false" ;;
                        yes|true|1)  value="true"  ;;
                    esac
                fi
                new_args+=("$new_flag" "$value")
                i=$((i+2))
            else
                new_args+=("$new_flag")
                i=$((i+1))
            fi
        fi
    else
        new_args+=("$arg")
        i=$((i+1))
    fi
done

# Find --db in new_args and force its value to the FASTA path (strip any
# trailing ".2bit").  The Rust binary reads FASTA directly, preserving IUB
# ambiguity codes that the 2bit format would degrade to N.
db_idx=-1
db_inline=false
for (( j=0; j<${#new_args[@]}; j++ )); do
    if [[ "${new_args[$j]}" == "--db" ]]; then
        db_idx=$j
        db_inline=false
        break
    elif [[ "${new_args[$j]}" == "--db="* ]]; then
        db_idx=$j
        db_inline=true
        break
    fi
done

if [ $db_idx -ge 0 ]; then
    if $db_inline; then
        db_val="${new_args[$db_idx]#--db=}"
    else
        val_idx=$((db_idx + 1))
        db_val="${new_args[$val_idx]}"
    fi

    db_base="${db_val%.2bit}"

    if [ ! -f "$db_base" ]; then
        echo "[rmblastn] Error: database file not found: $db_base" >&2
        exit 1
    fi

    if $db_inline; then
        new_args[$db_idx]="--db=${db_base}"
    else
        new_args[$val_idx]="$db_base"
    fi
fi

exec "$REAL_RMBLASTN" "${new_args[@]}"
