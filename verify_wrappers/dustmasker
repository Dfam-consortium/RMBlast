#!/bin/bash
# Cross-checking ("verify") replacement for NCBI dustmasker.
#
# Only rmblastn is A/B-compared in this directory; every other tool defers to
# the real NCBI binary so that any diff the verify rmblastn reports is
# attributable to rmblastn alone and nothing else in the pipeline moved.
# So this wrapper runs NCBI's dustmasker by default, exactly like the sibling
# blastdbcmd and makeblastdb wrappers do.
#
# The Rust dustmasker is already validated separately (126/126 byte-identical
# against NCBI 2.17.0 via run_dustmasker_compare.sh).  To exercise it here
# anyway -- e.g. to confirm an end-to-end RepeatModeler run against the
# all-Rust toolchain -- set:
#
#     RMBLAST_VERIFY_DUSTMASKER=rust
#
# which makes this wrapper resolve ../bin/dustmasker (installed release) or
# ../target/release/dustmasker (source checkout) instead.

NCBI_DIR="${NCBI_DIR:-/usr/local/rmblast-2.17.1/bin}"
NCBI_DUSTMASKER="$NCBI_DIR/dustmasker"
# ── Locate the Rust binaries relative to this wrapper ─────────────────────────
# The same script has to work from two layouts:
#   installed release   <root>/wrappers/<this>   -> <root>/bin/<name>
#   source checkout     rmblast/wrappers/<this>  -> rmblast/target/release/<name>
# Both are one level up from the wrapper, so try ../bin first and
# ../target/release second.  Setting RMBLAST_BIN_DIR overrides the search: the
# binary must then be in that directory or the wrapper fails.
#
# Symlinks are followed so the wrappers can be linked onto PATH individually.
__rmb_self="${BASH_SOURCE[0]}"
while [ -L "$__rmb_self" ]; do
    __rmb_dir="$(cd -- "$(dirname -- "$__rmb_self")" && pwd)"
    __rmb_self="$(readlink -- "$__rmb_self")"
    case "$__rmb_self" in /*) ;; *) __rmb_self="$__rmb_dir/$__rmb_self" ;; esac
done
RMBLAST_HERE="$(cd -- "$(dirname -- "$__rmb_self")" && pwd)"

rmblast_find_bin() {
    local name="$1" cand
    # An explicit RMBLAST_BIN_DIR is authoritative: if the binary is not there,
    # fail loudly rather than silently searching elsewhere.
    if [ -n "$RMBLAST_BIN_DIR" ]; then
        if [ -x "$RMBLAST_BIN_DIR/$name" ]; then
            printf '%s\n' "$RMBLAST_BIN_DIR/$name"
            return 0
        fi
        echo "[$(basename -- "$0")] Error: RMBLAST_BIN_DIR is set to '$RMBLAST_BIN_DIR'" \
             "but it holds no executable '$name'." >&2
        return 1
    fi
    for cand in "$RMBLAST_HERE/../bin/$name" \
                "$RMBLAST_HERE/../target/release/$name"; do
        [ -x "$cand" ] && { printf '%s\n' "$cand"; return 0; }
    done
    {
        echo "[$(basename -- "$0")] Error: cannot find the rmblast '$name' binary."
        echo "  looked in: $RMBLAST_HERE/../bin/"
        echo "             $RMBLAST_HERE/../target/release/"
        echo "  Build it with 'cargo build --release' / 'make', or set"
        echo "  RMBLAST_BIN_DIR=<directory containing $name>."
    } >&2
    return 1
}
# ──────────────────────────────────────────────────────────────────────────────

case "${RMBLAST_VERIFY_DUSTMASKER:-ncbi}" in
    rust)
        REAL_DUSTMASKER="$(rmblast_find_bin dustmasker)" || exit 1
        ;;
    ncbi)
        REAL_DUSTMASKER="$NCBI_DUSTMASKER"
        if [ ! -x "$REAL_DUSTMASKER" ]; then
            echo "[dustmasker] Error: NCBI dustmasker not found: $REAL_DUSTMASKER" >&2
            echo "  Set NCBI_DIR=<dir>, or RMBLAST_VERIFY_DUSTMASKER=rust to use the port." >&2
            exit 1
        fi
        ;;
    *)
        echo "[dustmasker] Error: RMBLAST_VERIFY_DUSTMASKER must be 'ncbi' or 'rust'," \
             "got '$RMBLAST_VERIFY_DUSTMASKER'" >&2
        exit 1
        ;;
esac

exec "$REAL_DUSTMASKER" "$@"
